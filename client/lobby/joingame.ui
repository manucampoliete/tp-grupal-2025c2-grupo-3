QPushButton {
    background: transparent; 
    color: #FFFFFF;
    font-family: &quot;orbitron&quot;; 
    font-size: 20pt; 
    font-weight: bold; 
    border: none;
    padding: 10px 15px; 
    text-align: left; 
}

QPushButton:hover {
    background-color: rgba(0, 150, 255, 0.3); 
    color: #FFD700; 
    border-left: 5px solid #00BFFF; 
    font-size: 20pt;
}

QPushButton:pressed {
    background-color: rgba(0, 100, 200, 0.5); 
    color: #FFA500; 
}

QLineEdit {
    background-color: #1a1a2e; 
    color: #FFFFFF;
    font-size: 11pt;
    padding: 5px; 
    border: 1px solid #4f4f60; 
    border-radius: 3px; 
}

QLineEdit:focus {
